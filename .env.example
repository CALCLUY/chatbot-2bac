# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the two placeholders below.
#   cp .env.example .env
#
# Everything is optional: with no .env at all the pipeline still runs, using a
# free offline embedder so you can test ingestion + retrieval immediately.
# ---------------------------------------------------------------------------

# --- The two values you must fill in for real embeddings -------------------
# Any OpenAI-compatible embeddings endpoint works (OpenAI, Azure, OpenRouter,
# Ollama, vLLM, Together, Mistral, ...).
EMBEDDING_MODEL=[EMBEDDING_MODEL_HERE]
EMBEDDING_API_KEY=[EMBEDDING_API_KEY_HERE]

# Only change this if you are not using OpenAI directly, e.g.
#   EMBEDDING_BASE_URL=http://localhost:11434/v1     # Ollama
#   EMBEDDING_BASE_URL=https://openrouter.ai/api/v1  # OpenRouter
EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- Backend selection ------------------------------------------------------
# auto                 : openai if the placeholders are filled in, else a local
#                        sentence-transformers model, else the offline fallback
# openai               : force the API (requires the placeholders to be filled)
# sentence-transformers: force a local model (needs the optional dependency)
# hashing              : force the free offline TF-IDF fallback (tests only)
EMBEDDING_BACKEND=auto

# Name of the local model used when the backend resolves to
# sentence-transformers. Good French + maths choice:
EMBEDDING_MODEL_LOCAL=intfloat/multilingual-e5-small

# --- Chat / tutor (step 2) ---------------------------------------------------
# Any OpenAI-compatible /v1/chat/completions endpoint (Aster relay, OpenAI,
# Ollama, OpenRouter, vLLM, ...).
CHAT_BASE_URL=https://chatbotoauth-z3twqyf2.manus.space/v1
CHAT_API_KEY=[CHAT_API_KEY_HERE]
CHAT_MODEL=gpt-5.6-luna
# CHAT_TEMPERATURE=0.7
# CHAT_TOP_K=6                 # chunks used to ground each answer
# CHAT_MAX_TOKENS=             # leave unset unless the endpoint requires it
# CHAT_TIMEOUT=120

# --- Retrieval refinement (see rag/selection.py) ------------------------------
# RETRIEVAL_MIN_SCORE_RATIO=0.5   # drop hits below this fraction of the top hit
# RETRIEVAL_MAX_PER_FILE=2        # at most N chunks from one source file
# RETRIEVAL_MMR_LAMBDA=0.6        # 1.0 = pure relevance, 0.0 = pure diversity

# --- Paths ------------------------------------------------------------------
# Where you cloned the corpus to, and where the index is written.
# DATA_DIR=./data/data-2bac-sma
# CHROMA_DIR=./data/chroma_db
# COLLECTION_NAME=2bac-sma

# --- Tuning -----------------------------------------------------------------
# EMBEDDING_BATCH_SIZE=64
# CHUNK_MAX_CHARS=1400
# CHUNK_MIN_CHARS=120
# TOP_K=5
